{
  "name": "counterpoint",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A timing-aware brainstorming cofacilitator for live Google Meet conversations.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "extension",
    "server",
    "shared"
  ],
  "scripts": {
    "build:extension": "npm run build --workspace @counterpoint/extension",
    "dev:server": "npm run dev --workspace @counterpoint/server",
    "start:server": "npm run start --workspace @counterpoint/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "verify": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.322",
    "@types/node": "^22.10.0",
    "tsx": "^4.20.5",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@openai/agents": "^0.18.0",
    "zod": "^4.6.2"
  }
}
