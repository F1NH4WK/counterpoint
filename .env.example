# Server-only credentials. Never expose these values in the Chrome extension.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=alloy

# The development server binds to loopback by default. After loading the
# extension, copy its ID from chrome://extensions into this origin.
COUNTERPOINT_HOST=127.0.0.1
COUNTERPOINT_PORT=8787
COUNTERPOINT_ALLOWED_ORIGINS=chrome-extension://YOUR_EXTENSION_ID

# Local-only convenience for an early spike. Prefer the explicit origin above.
COUNTERPOINT_ALLOW_ANY_CHROME_EXTENSION=false

# Optional shared secret checked by the local server. Do not commit its value.
COUNTERPOINT_DEMO_TOKEN=

# Exa is connected only after its Dashboard onboarding generates the
# stack-specific adapter. Keep this key server-side.
EXA_API_KEY=

# Configure later when a real internal MCP is selected. The first connector is
# read-only and runs on the server, never in the browser extension.
INTERNAL_MCP_URL=
INTERNAL_MCP_TOKEN=
